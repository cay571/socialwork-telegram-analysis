# Bu dosyayı "ayarlar.env" adıyla kopyalayıp doldurun.
# ayarlar.env dosyasını kimseyle paylaşmayın.

# my.telegram.org > API development tools sayfasından alınır
TG_API_ID=
TG_API_HASH=

# Grubun kullanıcı adı (ör. @grupadi), t.me bağlantısı ya da sayısal ID.
# Toplamayı yapan hesabın gruba üye olması gerekir.
TG_GRUP=

# Tarihler Türkiye saatiyle YYYY-MM-DD. Başlangıç dahil, bitiş dahil değil.
# Boş bırakılırsa sınır uygulanmaz.
BASLANGIC_TARIHI=
BITIS_TARIHI=2026-09-01

# 1: ham metni de sakla (erişimi kısıtlı/şifreli bir diskte tutun)
# 0: yalnızca kişisel bilgileri maskelenmiş metni sakla
HAM_METNI_SAKLA=0